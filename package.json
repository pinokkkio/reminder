{
  "name": "telegram-reminder-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-platform.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm test",
    "deploy": "npm run verify && tgcloud migrate --local --safe && tgcloud push && tgcloud migrate --safe && tgcloud run endpoints/setup",
    "migrate": "tgcloud migrate",
    "status": "tgcloud status",
    "tick": "tgcloud run endpoints/tick"
  },
  "devDependencies": {
    "@tgcloud/cli": "0.2.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
