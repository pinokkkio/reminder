{
  "name": "telegram-reminder-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply reminder-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply reminder-db --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
